# Copy to .env and fill in real values. This file may be committed.
DOCUMENTDB_URI="mongodb+srv://<username>:<password>@<cluster>.mongocluster.cosmos.azure.com/?tls=true&authMechanism=SCRAM-SHA-256&retrywrites=false&maxIdleTimeMS=120000"
AZURE_OPENAI_ENDPOINT=https://<resource>.services.ai.azure.com
AZURE_OPENAI_API_KEY=<key>
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4.1-mini

# Comma-separated API keys accepted by the API. Leave empty to disable API-key auth.
API_KEYS=

# JWT username/password login. Set JWT_SECRET plus the bootstrap admin below to
# enable /api/auth/login. Generate a secret with: python -c
# "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Bootstrap admin user (verified at request time; no seed needed).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_DISPLAY_NAME=Admin

# Allow anyone to create an account via POST /api/auth/register (role "user").
# Also controls whether the frontend shows the "Sign up" option.
ALLOW_SIGNUP=true

# Conversation memory: max history messages kept per session
CONVERSATION_HISTORY_LIMIT=12

# Rate limits: N requests per window (in seconds)
RATE_LIMIT_ASK=10
RATE_LIMIT_DOCS=5
RATE_LIMIT_CLEAR=10
RATE_LIMIT_REGISTER=5
RATE_LIMIT_DRAFT=10
RATE_LIMIT_SEND=5
RATE_LIMIT_WINDOW=60

# Upload limits
MAX_UPLOAD_BYTES=10485760

# Chunking
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# Minimum cosine score for local retrieval context (tune with real queries)
SIMILARITY_THRESHOLD=0.30

# IVF vector index (used by scripts/create_vector_index.py)
VECTOR_INDEX_DIMENSIONS=1536
VECTOR_INDEX_NUMLISTS=16

# Generation
GPT_TEMPERATURE=0.2
GPT_MAX_TOKENS=4096

# CORS. "*" for dev. In production set the frontend origin, e.g. https://faq.example.com
CORS_ORIGINS=*

# Serve the frontend from this directory at "/" (same origin). Leave empty for API-only.
# STATIC_DIR=../frontend

# Comma-separated trusted proxy IPs (e.g. your load balancer). Client IP is read
# from X-Forwarded-For only when the direct peer is one of these.
# TRUSTED_PROXY_IPS=10.0.0.4

# Logging
LOG_LEVEL=INFO

# --- Web search grounding (Chitkara University live info) ---
# Providers: duckduckgo | bing | wikipedia | none
WEB_SEARCH_PROVIDER=duckduckgo
WEB_SEARCH_ENABLED=true
# Search the web only when local retrieval finds nothing relevant.
WEB_SEARCH_FALLBACK=true
# Fetch the top pages so answers are grounded in full text, not just snippets.
WEB_PAGE_FETCH_ENABLED=true
WEB_PAGE_FETCH_LIMIT=3
WEB_PAGE_FETCH_MAX_BYTES=12000
WEB_SEARCH_RESULT_LIMIT=5
# Only needed if WEB_SEARCH_PROVIDER=bing
# BING_SEARCH_API_KEY=

# Optional Redis for shared conversation memory + distributed rate limiting.
# REDIS_URL=redis://localhost:6379/0

# --- Help desk email / SMTP fallback ---
# When the RAG system cannot find a reliable answer, the chatbot offers to
# email the university help desk. The user must review the draft and confirm
# before anything is sent. Credentials stay server-side and are never exposed
# to the frontend or returned by the API.
#
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, username = your
# Gmail address, password = a 16-character App Password (smtp.gmail.com does
# NOT accept your normal account password).
#
# Outlook/Office 365: SMTP_HOST=smtp.office365.com, SMTP_PORT=587,
# password = your Microsoft account password or app password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Upgrade to STARTTLS after connecting. Set false for implicit TLS (port 465).
SMTP_USE_TLS=true
SMTP_USERNAME=your-gmail@gmail.com
SMTP_PASSWORD=xxxxxxxxxxxxxxxx
# The help-desk mailbox students' emails are always sent to.
HELPDESK_EMAIL=oia@chitkara.edu.in
EMAIL_SEND_TIMEOUT=15
EMAIL_SIGNATURE_NAME=Himanshu